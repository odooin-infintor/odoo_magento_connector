<odoo>
    <record id="privilege_magento" model="res.groups.privilege">
        <field name="name">Magento Connector</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_magento_user" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_magento"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_magento_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_magento"/>
        <field name="implied_ids" eval="[Command.link(ref('group_magento_user')), Command.link(ref('queue_job.group_queue_job_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
    <record id="rule_instance_company" model="ir.rule">
        <field name="name">Magento connections by company</field>
        <field name="model_id" ref="model_in_magento_instance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_product_company" model="ir.rule">
        <field name="name">Magento products by company</field>
        <field name="model_id" ref="model_in_magento_product_binding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_category_company" model="ir.rule">
        <field name="name">Magento categories by company</field>
        <field name="model_id" ref="model_in_magento_category_binding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_partner_company" model="ir.rule">
        <field name="name">Magento customers by company</field>
        <field name="model_id" ref="model_in_magento_partner_binding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_order_company" model="ir.rule">
        <field name="name">Magento orders by company</field>
        <field name="model_id" ref="model_in_magento_order_binding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tax_company" model="ir.rule">
        <field name="name">Magento taxes by company</field>
        <field name="model_id" ref="model_in_magento_tax_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sync_log_company" model="ir.rule">
        <field name="name">Magento sync logs by company</field><field name="model_id" ref="model_in_magento_sync_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sync_log_change_company" model="ir.rule">
        <field name="name">Magento sync changes by company</field><field name="model_id" ref="model_in_magento_sync_log_change"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
<record id="rule_template_binding_company" model="ir.rule"><field name="name">Configurable product by company</field><field name="model_id" ref="model_in_magento_template_binding"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_attribute_mapping_company" model="ir.rule"><field name="name">Attribute by company</field><field name="model_id" ref="model_in_magento_attribute_mapping"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_attribute_value_company" model="ir.rule"><field name="name">Attribute value by company</field><field name="model_id" ref="model_in_magento_attribute_value"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_inventory_source_company" model="ir.rule"><field name="name">Inventory source by company</field><field name="model_id" ref="model_in_magento_inventory_source"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_shipment_company" model="ir.rule"><field name="name">Shipments by company</field><field name="model_id" ref="model_in_magento_shipment"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_catalog_field_company" model="ir.rule"><field name="name">Magento catalog_field by company</field><field name="model_id" ref="model_in_magento_catalog_field"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_customer_address_company" model="ir.rule"><field name="name">Magento customer_address by company</field><field name="model_id" ref="model_in_magento_customer_address"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_accounting_company" model="ir.rule"><field name="name">Magento accounting by company</field><field name="model_id" ref="model_in_magento_accounting"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>
