<odoo>
    <record id="view_sync_log_list" model="ir.ui.view">
        <field name="name">in.magento.sync.log.list</field>
        <field name="model">in.magento.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="status == 'failed'" decoration-warning="status == 'retry'">
                <field name="occurred_at"/><field name="instance_id"/><field name="direction"/>
                <field name="reference"/><field name="operation"/><field name="status" widget="badge"/>
                <field name="summary"/><field name="trigger"/><field name="user_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_sync_log_form" model="ir.ui.view">
        <field name="name">in.magento.sync.log.form</field>
        <field name="model">in.magento.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="summary"/></h1></div>
                    <group>
                        <group><field name="instance_id"/><field name="occurred_at"/><field name="direction"/>
                            <field name="operation"/><field name="status"/><field name="reference"/></group>
                        <group><field name="trigger"/><field name="user_id"/><field name="attempt"/>
                            <field name="job_id" string="Background Job" groups="in_odoo_magento_connector.group_magento_manager"/>
                            <field name="job_uuid"/>
                            <field name="previous_source"/><field name="currency_code"/></group>
                    </group>
                    <group string="Related records">
                        <field name="shipment_id" invisible="not shipment_id"/>
                        <field name="attribute_mapping_id" invisible="not attribute_mapping_id"/>
                        <field name="product_binding_id" invisible="not product_binding_id"/><field name="template_binding_id" invisible="not template_binding_id"/>
                        <field name="product_id" invisible="not product_id"/>
                        <field name="category_binding_id" invisible="not category_binding_id"/>
                        <field name="order_binding_id" invisible="not order_binding_id"/>
                        <field name="sale_order_id" invisible="not sale_order_id"/>
                    </group>
                    <div class="alert alert-info" role="status" invisible="direction != 'export' or status != 'success'">
                        Magento accepted this API write. New values show what Odoo sent; storefront indexing and caching may finish later.
                    </div>
                    <group invisible="not error"><field name="error"/></group>
                    <field name="change_ids" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="field_name"/><field name="previous_value"/><field name="new_value"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_sync_log_search" model="ir.ui.view">
        <field name="name">in.magento.sync.log.search</field><field name="model">in.magento.sync.log</field>
        <field name="arch" type="xml">
            <search><field name="reference"/><field name="instance_id"/><field name="summary"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="retry" string="Retries" domain="[('status', '=', 'retry')]"/>
                <separator/>
                <filter name="exports" string="Odoo → Magento" domain="[('direction', '=', 'export')]"/>
                <filter name="imports" string="Magento → Odoo" domain="[('direction', '=', 'import')]"/>
                <separator/>
                <filter name="automatic" string="Automatic" domain="[('trigger', '=', 'automatic')]"/>
                <filter name="date" string="Date" date="occurred_at"/>
                <group><filter name="group_connection" string="Connection" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sync_logs" model="ir.actions.act_window">
        <field name="name">Sync Logs</field><field name="res_model">in.magento.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Sync history will appear here after the next synchronization.</p>
            <p>Trace exports, imports, changed fields and background failures. Unchanged automatic checks are omitted.</p></field>
    </record>
</odoo>
